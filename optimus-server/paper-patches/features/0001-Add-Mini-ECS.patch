     // Paper start
     public com.destroystokyo.paper.profile.PlayerProfile getPlayerProfile() {
@@ -2049,8 +2053,20 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
 
     public void onEntityRemove(Entity entity) {
         this.invertedVisibilityEntities.remove(entity.getUUID());
+        this.optimus$syncVisibilityBit(); // Optimus - Mini ECS
     }
 
+    // Optimus start - Mini ECS
+    public boolean optimus$hasInvertedVisibility() {
+        return !this.invertedVisibilityEntities.isEmpty();
+    }
+
+    private void optimus$syncVisibilityBit() {
+        ServerPlayer handle = this.getHandle();
+        if (handle.ecsSlot != -1) pl.optimusteam.optimus.ecs.PlayerComponents.setHasInvertedVisibility(handle.ecsSlot, !this.invertedVisibilityEntities.isEmpty());
+    }
+    // Optimus end - Mini ECS
+
     @Override
     public boolean canSee(Player player) {
         return this.canSee((org.bukkit.entity.Entity) player);
