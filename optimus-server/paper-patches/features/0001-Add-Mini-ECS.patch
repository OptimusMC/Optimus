+        this.optimus$syncVisibilityBit(); // Optimus - Mini ECS
 
         return true;
     }
@@ -1901,6 +1902,7 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
         if (this.invertedVisibilityEntities.remove(entity.getUniqueId()) == null) {
             this.untrackAndHideEntity(entity);
         }
+        this.optimus$syncVisibilityBit(); // Optimus - Mini ECS
     }
 
     @Override
@@ -1944,6 +1946,7 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
             return false; // Some other plugins still want the entity inverted
         }
         this.invertedVisibilityEntities.remove(entity.getUniqueId());
+        this.optimus$syncVisibilityBit(); // Optimus - Mini ECS
 
         return true;
     }
@@ -2017,6 +2020,7 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
         if (this.invertedVisibilityEntities.remove(entity.getUniqueId()) == null) {
             this.trackAndShowEntity(entity);
