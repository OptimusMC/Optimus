             // SPIGOT-6907: re-implement LivingEntity#setMaximumAir()
             this.maxAirTicks = input.getIntOr("Bukkit.MaxAirSupply",this.maxAirTicks);
             // CraftBukkit end
@@ -4524,6 +4538,7 @@ public abstract class Entity
         if (len < 0) maxZ = minZ;
         if (len > 64) maxZ = minZ + 64.0;
         this.bb = new AABB(minX, minY, minZ, maxX, maxY, maxZ);
+        if (this.ecsEntitySlot != -1) pl.optimusteam.optimus.ecs.EntityComponents.setBb(this.ecsEntitySlot, minX, minY, minZ, maxX, maxY, maxZ); // Optimus - Mini ECS
         // CraftBukkit end
     }
 
@@ -4967,6 +4982,10 @@ public abstract class Entity
             synchronized (this.posLock) { // Paper - detailed watchdog information
             this.position = new Vec3(x, y, z);
             } // Paper - detailed watchdog information
+            // Optimus start - Mini ECS
+            if (this.ecsEntitySlot != -1) pl.optimusteam.optimus.ecs.EntityComponents.setPos(this.ecsEntitySlot, x, y, z);
+            if (this.ecsSlot != -1) pl.optimusteam.optimus.ecs.PlayerComponents.setPos(this.ecsSlot, x, y, z);
+            // Optimus end - Mini ECS
             int fx = Mth.floor(x);
             int fy = Mth.floor(y);
             int fz = Mth.floor(z);
@@ -5186,6 +5205,7 @@ public abstract class Entity
 
