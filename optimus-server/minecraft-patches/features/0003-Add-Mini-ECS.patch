@@ -387,6 +387,20 @@ public abstract class Entity
     public long activatedTick = Integer.MIN_VALUE;
     public boolean isTemporarilyActive;
     public long activatedImmunityTick = Integer.MIN_VALUE;
+    // Optimus start - Mini ECS
+    public int ecsSlot = -1;
+    public int ecsEntitySlot = -1;
+
+    public final void optimus$setActivatedTick(final long tick) {
+        this.activatedTick = tick;
+        if (this.ecsEntitySlot != -1) pl.optimusteam.optimus.ecs.EntityComponents.setActivatedTick(this.ecsEntitySlot, tick);
+    }
+
+    public final void optimus$setVisibleByDefault(final boolean visible) {
+        this.visibleByDefault = visible;
+        if (this.ecsEntitySlot != -1) pl.optimusteam.optimus.ecs.EntityComponents.setVisibleByDefault(this.ecsEntitySlot, visible);
+    }
+    // Optimus end - Mini ECS
 
     public void inactiveTick() {
     }
@@ -1152,7 +1166,7 @@ public abstract class Entity
             if (moverType == MoverType.PISTON) {
                 delta = this.limitPistonMovement(delta);
                 // Paper start - EAR 2
-                this.activatedTick = Math.max(this.activatedTick, net.minecraft.server.MinecraftServer.currentTick + 20);
+                this.optimus$setActivatedTick(Math.max(this.activatedTick, net.minecraft.server.MinecraftServer.currentTick + 20)); // Optimus - Mini ECS
                 this.activatedImmunityTick = Math.max(this.activatedImmunityTick, net.minecraft.server.MinecraftServer.currentTick + 20);
                 // Paper end - EAR 2
                 if (delta.equals(Vec3.ZERO)) {
@@ -2757,7 +2771,7 @@ public abstract class Entity
             }
